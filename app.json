{
  "expo": {
    "name": "IDAP HSE",
    "slug": "idap-hse-survey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/HSE_icon.png",
    "scheme": "idaphse",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.idap.hsesurvey",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/HSE_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/idaplogo.png",
          "imageWidth": 200
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "847a6be6-4eba-42ac-85ef-a2da0bc4fb98"
      }
    },
    "owner": "bilalkhandevs-team"
  }
}
